  "title": "Lock with a green light for codes 5, 6, 12, 13 and a red light for codes 1, 2, 3, 4, built from only NAND chips, at most 19",
  "spec": "A lock with 4 switches a, b, c, d (a is the biggest digit of the binary number): the green light turns on only for the numbers 5, 6, 12 or 13, the red light turns on only for the numbers 1, 2, 3 or 4, and for every other number both lights stay off. Build it using only NAND chips (a NOT is a NAND with both inputs tied together) and at most 19 chips in total.",
  "inputs": [
   "a",
   "b",
   "c",
   "d"
  ],
  "outputs": [
   "green",
   "red"
  ],
  "allowed_gates": [
   "NAND"
  ],
  "gate_budget": 19,
  "flipflops_allowed": false,
  "seed": 938018053,
  "sequence": null
 },
