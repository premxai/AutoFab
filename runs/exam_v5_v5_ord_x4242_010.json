  "title": "Door lock that opens only for codes 1, 4, 11, 13, built from only NAND chips, at most 18",
  "spec": "A door lock with 4 switches a, b, c, d (a is the biggest digit of the binary number): the light y turns on only when the switches show the numbers 1, 4, 11 or 13, and stays off for every other number. Build it using only NAND chips (a NOT is a NAND with both inputs tied together) and at most 18 chips in total.",
  "inputs": [
   "a",
   "b",
   "c",
   "d"
  ],
  "outputs": [
   "y"
  ],
  "allowed_gates": [
   "NAND"
  ],
  "gate_budget": 18,
  "flipflops_allowed": false,
  "seed": 772317578,
  "sequence": null
 },
